# Copy to .env.local (git-ignored) to override settings on your machine, or set
# these as environment variables (e.g. in the Netlify UI). Variables that are
# already in the environment when `vite build` runs win over .env files.

# WebSocket endpoint of the Rust server.
# Unset = same host the page was loaded from, port 8000 (ws:// on http pages,
# wss:// on https pages). Production (Netlify):
#   VITE_WS_URL=wss://api.jamesworld.lol/ws
# Other examples:
#   VITE_WS_URL=ws://localhost:8000/ws
#   VITE_WS_URL=ws://192.168.1.20:8000/ws
# VITE_WS_URL=

# Room sent in the Join message.
VITE_ROOM_ID=default
