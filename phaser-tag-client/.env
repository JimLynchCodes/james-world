# Local development settings (committed; safe defaults, no secrets).
#
# VITE_WS_URL: WebSocket endpoint of the Rust server.
# Leave it unset locally: the client then connects to the same host it was
# loaded from, on port 8000 (ws://localhost:8000/ws on this machine, or
# ws://192.168.x.y:8000/ws when a phone on your Wi-Fi opens the dev server).
# Production sets it in the Netlify UI instead (it wins over this file):
#   VITE_WS_URL=wss://api.jamesworld.lol/ws
# VITE_WS_URL=ws://localhost:8000/ws

# Room sent in the Join message.
VITE_ROOM_ID=default
