# WebSocket endpoint exposed by the Rust server.
# Examples:
# VITE_WS_URL=ws://localhost:3000/ws
# VITE_WS_URL=wss://example.com/ws
VITE_WS_URL=ws://localhost:8000/ws

# Room sent in the Join message.
VITE_ROOM_ID=default

# Temporary development workaround because the current protocol
# does not tell the client its own UUID.
# VITE_PLAYER_ID=00000000-0000-0000-0000-000000000000
